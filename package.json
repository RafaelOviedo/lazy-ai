{
  "name": "@rafaeloviedo/lazyai",
  "version": "1.0.0",
  "description": "Keyboard-first terminal UI for managing Claude Code and Codex sessions",
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "lazyai": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelOviedo/lazy-ai.git"
  },
  "bugs": {
    "url": "https://github.com/RafaelOviedo/lazy-ai/issues"
  },
  "homepage": "https://github.com/RafaelOviedo/lazy-ai#readme",
  "engines": {
    "node": ">=20"
  },
  "author": "Rafael Oviedo Paz",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@b9g/termdom": "^0.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
